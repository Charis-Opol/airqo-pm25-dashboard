# Copy this file to .env for local runs (.env is not committed).
# On Render, set the same names under Environment instead of using a file.

# --- API ---------------------------------------------------------------
# Key that callers must send in the "X-API-Key" header for /api/* and POST /predict.
# Leave empty to keep the API open (no key needed). /health is always open.
API_KEY=https://airqo-cole-charis-assgnmnt.onrender.com

# Sites allowed to call the API from a browser (comma separated), or * for any.
# Example: https://my-dashboard.onrender.com
ALLOWED_ORIGINS=https://airqo-cole-charis-assgnmnt.onrender.com

# --- Dashboard (web/) ----------------------------------------------------
# Where the dashboard reads its data from. Leave empty when the dashboard and
# the API are the same service. Set it when the API runs on another service,
# e.g. https://airqo-pm25-api.onrender.com (no trailing slash).
UI_API_BASE_URL=https://airqo-cole-charis-assgnmnt.onrender.com

# Key the dashboard sends as "X-API-Key". Leave empty to reuse API_KEY.
# Note: the browser receives this key, so anyone who can open the dashboard can read it.
UI_API_KEY=https://airqo-cole-charis-assgnmnt.onrender.com